{
  "name": "guacd-ts",
  "version": "0.2.0",
  "description": "TypeScript library for bridging WebSocket connections to Apache Guacamole guacd daemon",
  "license": "Apache-2.0",
  "author": "YasushiMatsumoto",
  "repository": {
    "type": "git",
    "url": "https://github.com/YasushiMatsumoto/guacd-ts.git"
  },
  "keywords": [
    "guacamole",
    "guacd",
    "rdp",
    "vnc",
    "ssh",
    "telnet",
    "websocket",
    "remote-desktop",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol-types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
